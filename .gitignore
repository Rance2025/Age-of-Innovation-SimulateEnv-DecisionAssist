# ============================================
# 依赖目录
# ============================================
# Node.js 依赖 - 通过 package.json 重新安装
node_modules/
frontend/node_modules/

# Python 依赖 - 通过 requirements.txt 重新安装
venv/
env/
ENV/
.venv/

# ============================================
# 构建输出
# ============================================
# Vue/Vite 构建输出 - 自动生成
dist/
frontend/dist/
dist-ssr/
*.local

# Python 编译缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ============================================
# 日志文件
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# 编辑器/IDE 配置
# ============================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
*.sublime-project
*.sublime-workspace

# ============================================
# 环境配置文件（包含敏感信息）
# ============================================
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# ============================================
# 测试相关
# ============================================
coverage/
.nyc_output/

# ============================================
# 临时文件
# ============================================
*.tmp
*.temp
.cache/
temp/
tmp/

# ============================================
# 本地数据文件（如果包含敏感信息）
# ============================================
# 根据项目需要决定是否忽略
data/*.db
data/*.sqlite
*.db
*.sqlite
